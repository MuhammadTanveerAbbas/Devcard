# Copy these keys into .env.local to light up the stats side.
# .env.local is gitignored. Never commit a token.
# Do not add NEXT_PUBLIC_ to any key below: all values stay on the server.

# ─── GitHub ────────────────────────────────────────────────────────────────────
# Classic personal access token. Fills the contribution heatmap, streak,
# commits, merged PRs, stars, followers and recent repositories.
GITHUB_TOKEN=
GITHUB_USERNAME=muhammadtanveerabbas

# ─── Cache ─────────────────────────────────────────────────────────────────────
# How long fetched stats stay fresh, in minutes.
STATS_CACHE_MINUTES=60
